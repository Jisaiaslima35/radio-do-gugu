# =============================================================================
# Rádio do Gugu — Environment variables (EXEMPLO, sem secrets reais)
# =============================================================================
# Copie pra .env e preencha os valores reais. NUNCA commitar .env.

# --- Backend Node.js ---
PORT=3006
NODE_ENV=production

# --- Hermes (CLI local) ---
HERMES_BIN=/usr/local/bin/hermes
HERMES_PROFILE=radio-gugu
HERMES_TIMEOUT_MS=60000

# --- AzuraCast ---
AZURACAST_HOST=localhost
AZURACAST_BASE_PORT=9000  # porta base das estações
AZURACAST_STATION_ID=7

# --- MiniMax TTS ---
# Plano: Audio Starter R$13,50 (NÃO usar token-plan!)
MINIMAX_API_KEY=sk-PREENCHA_SUA_CHAVE_AQUI
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_VOICE_ID=Portuguese_Deep-VoicedGentleman
MINIMAX_MODEL=speech-2.8-hd
MINIMAX_SPEED=0.85

# --- Edge TTS (fallback se MiniMax cair) ---
EDGE_TTS_VOICE=pt-BR-AntonioNeural
EDGE_TTS_RATE=-15%
EDGE_TTS_PITCH=-10Hz

# --- Paths ---
MUSICAS_DIR=/opt/radio-do-gugu/audios
VINHETAS_DIR=/opt/radio-do-gugu/vinhetas
LOGS_DIR=/opt/radio-do-gugu/logs
